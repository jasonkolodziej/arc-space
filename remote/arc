#!/usr/bin/env bash
# arc — small Slurm/storage helper for UTSA Arc. Install to ~/.local/bin/arc.
# Used directly in terminals and by the workspace tasks.
set -euo pipefail

HOLD="${ARC_HOLD_JOB:-vscode}"
WORK="${ARC_WORK:-/work/$USER}"
VAULT="${ARC_VAULT:-/vault/research/$USER}"
LOGDIR="$HOME/.arc/logs"
mkdir -p "$LOGDIR"

die() { echo "arc: $*" >&2; exit 1; }

part_cpus() { sinfo -h -p "$1" -o %c | head -n1 | tr -d '+'; }
part_gpu_gres() {  # first gpu GRES token for a partition, e.g. gpu:v100:2
  sinfo -h -p "$1" -o %G | head -n1 | sed 's/([^)]*)//g' | tr ',' '\n' | grep '^gpu' | head -n1 || true
}
holder() { squeue -u "$USER" --name="$HOLD" -h -o "%i|%T|%N|%L|%R" | head -n1; }

cmd_partitions() {
  sinfo -o "%.12P %.5a %.11l %.6D %.9t %.5c %.8m %.22G"
}

cmd_idle() {
  echo "Idle (allocatable) nodes by partition — nodes are exclusive per user, so 'mix' is not available to you:"
  sinfo -h -t idle -o "%P %D" | awk '{a[$1]+=$2} END {for (p in a) printf "  %-12s %3d idle\n", p, a[p]}' | sort
}

cmd_jobs() {
  squeue -u "$USER" -o "%.10i %.10P %.22j %.9T %.10M %.10L %.4D %R"
  local n; n=$(squeue -u "$USER" -h | wc -l)
  echo "— $n / 10 active jobs (Arc fair-use limit)"
}

cmd_alloc() {  # arc alloc PARTITION [HH:MM:SS] [CPUS]
  local part="${1:?usage: arc alloc PARTITION [TIME] [CPUS]}" time="${2:-04:00:00}" cpus="${3:-}"
  [ -n "$(holder)" ] && die "a '$HOLD' job already exists: $(holder)  (arc release first)"
  [ -z "$cpus" ] && cpus=$(part_cpus "$part")
  local gres; gres=$(part_gpu_gres "$part")
  local extra=()
  if [ -n "$gres" ]; then
    extra+=(--gres="$gres")
    echo "NOTE: GPU partition. Arc terminates jobs whose GPUs sit idle for more than 1 hour."
    echo "      Hold GPU nodes only while you are actually running GPU work."
  fi
  local id
  id=$(sbatch --parsable -J "$HOLD" -p "$part" -t "$time" -N 1 -n 1 -c "$cpus" ${extra[@]+"${extra[@]}"} \
        -o "$LOGDIR/%x-%j.log" --wrap "sleep infinity")
  id="${id%%;*}"
  echo "Submitted holder job $id on $part ($time, $cpus cores${gres:+, $gres}). Waiting…"
  for _ in $(seq 1 120); do
    IFS='|' read -r state node reason <<<"$(squeue -j "$id" -h -o "%T|%N|%R")"
    case "$state" in
      RUNNING) echo "READY  node=$node  -> connect with Remote-SSH host 'arc-node'"; return 0 ;;
      "")      die "job $id disappeared; see $LOGDIR" ;;
      *)       printf '\r  %s (%s)   ' "$state" "$reason" ;;
    esac
    sleep 5
  done
  echo; echo "Still pending after 10 min; it stays queued. Check 'arc jobs'."
}

cmd_node()    { local h; h=$(holder); [ -n "$h" ] || die "no '$HOLD' job"; echo "$h" | cut -d'|' -f3; }
cmd_release() { scancel -u "$USER" --name="$HOLD" && echo "Released '$HOLD' job(s)."; }

cmd_shell() {  # attach a shell to a running job (default: holder)
  local id="${1:-$(holder | cut -d'|' -f1)}"
  [ -n "$id" ] || die "no job id and no '$HOLD' job"
  exec srun --jobid="$id" --overlap --pty bash -l
}

cmd_interactive() {  # doc-style: srun -p PART -n 1 -t TIME -c CPUS --pty bash
  local part="${1:?usage: arc interactive PARTITION [TIME]}" time="${2:-02:00:00}"
  local cpus gres; cpus=$(part_cpus "$part"); gres=$(part_gpu_gres "$part")
  exec srun -p "$part" -n 1 -t "$time" -c "$cpus" ${gres:+--gres="$gres"} --pty bash -l
}

cmd_eff() {
  local id="${1:?usage: arc eff JOBID}"
  sacct -j "$id" --format=JobID,JobName,Partition,Elapsed,State,AllocCPUS,TotalCPU,ReqMem,MaxRSS,ExitCode
}

cmd_log() {
  local id="${1:?usage: arc log JOBID}" f
  f=$(scontrol show job "$id" | tr ' ' '\n' | sed -n 's/^StdOut=//p')
  [ -n "$f" ] || die "no StdOut for $id (finished jobs: default is slurm-$id.out in the submit dir)"
  exec tail -n 200 -F "$f"
}

cmd_storage() {
  echo "== /home  (backed up · 100 GB hard quota · code, envs, builds)"
  lfs quota -h -u "$USER" /home 2>/dev/null || df -hP "$HOME"
  echo; echo "== /work  (NOT backed up · 30-day unaccessed purge · job I/O, data, logs)"
  lfs quota -h -u "$USER" /work 2>/dev/null || df -hP "$WORK"
  echo; echo "== vault ($VAULT)  (backed up + replicated · 1 TB · archive)"
  df -hP "$VAULT" 2>/dev/null || echo "  vault not mounted here (check path / node)"
}

cmd_purge() {  # list /work files not accessed in N days (default 25 -> 5-day warning)
  local days="${1:-25}"
  echo "Files in $WORK not accessed for >$days days (purge window is 30):"
  find "$WORK" -xdev -type f -atime +"$days" -printf '%AY-%Am-%Ad  %10s  %p\n' 2>/dev/null \
    | sort | tee "$HOME/.arc/purge-candidates.txt" | tail -n 200
  echo "— full list: ~/.arc/purge-candidates.txt  (archive what you need: arc archive PATH)"
}

cmd_archive() {  # arc archive /work/$USER/some/path  -> $VAULT/from-work/some/path
  local src="${1:?usage: arc archive PATH}"; src=$(realpath "$src")
  local rel="${src#"$WORK"/}"; [ "$rel" = "$src" ] && rel=$(basename "$src")
  local dest="$VAULT/from-work/$(dirname "$rel")"
  mkdir -p "$dest"
  rsync -ah --info=progress2 "$src" "$dest/"
  echo "Archived -> $dest/$(basename "$src")  (source kept)"
}

cmd_stage() {  # copy from home/vault into /work for job I/O
  local src="${1:?usage: arc stage PATH}"; src=$(realpath "$src")
  local dest="$WORK/staged"; mkdir -p "$dest"
  rsync -ah --info=progress2 "$src" "$dest/"
  echo "Staged -> $dest/$(basename "$src")"
}

# ── checkpoint signalling (see remote/ckpt/README.md) ──
last_running() {  # newest running job that isn't the VS Code holder
  squeue -u "$USER" -h -t RUNNING -o "%i %j" | awk -v h="$HOLD" '$2 != h {print $1}' | tail -n1
}
ckpt_dir="${ARC_CKPT_STATE_DIR:-$HOME/.arc/ckpt}"

cmd_ckpt() {  # arc ckpt save|stop|status [JOBID] [--no-resume]
  local sub="${1:-status}"; shift || true
  local id="" noresume=""
  for a in "$@"; do case "$a" in --no-resume) noresume=1 ;; *) id="$a" ;; esac; done
  case "$sub" in
    save|stop)
      [ -n "$id" ] || id=$(last_running)
      [ -n "$id" ] || id=$(holder | awk -F'|' '$2 == "RUNNING" {print $1}')
      [ -n "$id" ] || die "no running job (pass a JOBID)"
      mkdir -p "$ckpt_dir"
      [ "$sub" = stop ] && [ -n "$noresume" ] && touch "$ckpt_dir/$id.noresume"
      local sig=USR2; [ "$sub" = stop ] && sig=USR1
      # --full reaches the batch shell *and* every step, however the trainer was launched.
      # A trainer started by hand on the holder node isn't in a Slurm step: use the request file.
      if [ "$id" = "$(holder | cut -d'|' -f1)" ]; then
        touch "$ckpt_dir/$id.$sub"; echo "Left request file $ckpt_dir/$id.$sub (picked up within 15 s)."
      elif scancel --full --signal="$sig" "$id"; then
        echo "Sent SIG$sig to job $id ($([ "$sub" = save ] && echo 'save and continue' || echo "save and exit${noresume:+, no resume}"))."
      else  # e.g. older Slurm without --full: leave a request file the guard polls (≤15 s)
        touch "$ckpt_dir/$id.$sub"; echo "Signal failed; left request file $ckpt_dir/$id.$sub"
      fi
      echo "Watch: arc ckpt status $id   ·   arc log $id"
      ;;
    status)
      local files
      if [ -n "$id" ]; then files="$ckpt_dir/$id.json"; else files=$(ls -t "$ckpt_dir"/*.json 2>/dev/null | head -n 10); fi
      [ -n "$files" ] || { echo "No checkpoint status yet (the trainer writes $ckpt_dir/<jobid>.json)."; return; }
      for f in $files; do
        [ -f "$f" ] || { echo "$(basename "$f" .json): no status file"; continue; }
        python3 - "$f" <<'PY'
import json, sys, time
d = json.load(open(sys.argv[1])); now = time.time(); ls = d.get("last_save") or {}
ago = lambda t: f"{int((now - t) // 60)} min ago" if t else "never"
left = f"{int((d['end_time'] - now) // 60)} min left" if d.get("end_time") else "end time unknown"
print(f"{d['job_id']:>12}  {d['state']:<18} {left:<16} restart {d.get('restart_count', 0)}  "
      f"last save {ago(ls.get('time'))} (step {ls.get('step')})  {d.get('reason') or ''}")
PY
      done
      ;;
    *) die "usage: arc ckpt save|stop|status [JOBID] [--no-resume]" ;;
  esac
}

cmd_why() {  # arc why JOBID — how a job ended, in words
  local id="${1:?usage: arc why JOBID}"
  sacct -j "$id" -n -P --format=JobID,State,ExitCode,DerivedExitCode,Elapsed,Timelimit | while IFS='|' read -r jid st ec dec el tl; do
    local code="${ec%%:*}" sig="${ec##*:}" note=""
    case "$st" in
      TIMEOUT*)        note="hit the walltime ($el of $tl). Slurm sent SIGTERM, then SIGKILL after KillWait." ;;
      CANCELLED*)      note="cancelled (scancel, or a step killed when its job ended)." ;;
      OUT_OF_MEMORY*)  note="out of memory — raise --mem or reduce batch size." ;;
      NODE_FAIL*)      note="node failed — resume from your last checkpoint." ;;
      PREEMPTED*)      note="preempted." ;;
      FAILED*)         note="exited non-zero (exit $code)." ;;
      COMPLETED*)      note="completed (exit $code)." ;;
      REQUEUED*)       note="requeued (resumed under the same id)." ;;
    esac
    [ "$sig" != 0 ] && note="$note killed by signal $sig ($(kill -l "$sig" 2>/dev/null || echo ?))."
    [ "$code" = 99 ] && note="$note exit 99 = checkpointed and asked to be resumed."
    printf '%-16s %-14s %-6s %s\n' "$jid" "$st" "$ec" "$note"
  done
}

case "${1:-help}" in
  partitions|idle|jobs|alloc|node|release|shell|interactive|eff|log|storage|purge|archive|stage|ckpt|why)
    c="$1"; shift; "cmd_$c" "$@" ;;
  *) sed -n '2,3p' "$0"; echo "commands: partitions idle jobs alloc node release shell interactive eff log storage purge archive stage ckpt why" ;;
esac
