{
  "name": "arc-space",
  "displayName": "Arc Space — HPC Manager",
  "description": "Guided Remote-SSH setup for UTSA Arc (Login, ControlMaster, compute-node hop), partitions/nodes, your Slurm jobs, tasks, and home/work/vault storage.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/arc-filled.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-ssh"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.138.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc",
          "title": "Arc HPC",
          "icon": "media/arc.svg"
        }
      ]
    },
    "views": {
      "arc": [
        {
          "id": "arc.jobs",
          "name": "My Jobs"
        },
        {
          "id": "arc.partitions",
          "name": "Partitions & Nodes"
        },
        {
          "id": "arc.storage",
          "name": "Storage"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "arc.jobs",
        "contents": "Arc isn't set up yet.\n[Run Setup](command:arc.setup.all)\n[Open Walkthrough](command:workbench.action.openWalkthrough?%22local.arc-slurm%23arc.setup%22)",
        "when": "!arc.setup.ssh"
      }
    ],
    "walkthroughs": [
      {
        "id": "arc.setup",
        "title": "Set up UTSA Arc",
        "description": "SSH with one DUO prompt, a compute-node hop for VS Code, and a Lustre-friendly workspace.",
        "steps": [
          {
            "id": "ssh",
            "title": "Configure SSH",
            "description": "Adds one Include line to the top of your ssh config and writes a managed `~/.ssh/arc-slurm.conf` plus proxy script.\n[Configure SSH](command:arc.setup.ssh)",
            "media": {
              "markdown": "media/walkthrough/ssh.md"
            },
            "completionEvents": [
              "onContext:arc.setup.ssh"
            ]
          },
          {
            "id": "settings",
            "title": "Apply VS Code user settings",
            "description": "Reviews and merges the Remote-SSH settings Arc needs (DUO login terminal, socket mode on shared login nodes).\n[Review settings](command:arc.setup.userSettings)",
            "media": {
              "markdown": "media/walkthrough/settings.md"
            },
            "completionEvents": [
              "onContext:arc.setup.settings"
            ]
          },
          {
            "id": "signin",
            "title": "Sign in (DUO)",
            "description": "Opens a local terminal for your password + DUO. The connection is reused ~10 h by everything else.\n[Sign in](command:arc.signIn)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onContext:arc.setup.signedIn"
            ]
          },
          {
            "id": "key",
            "title": "Install an SSH key",
            "description": "Needed for the Mac → compute-node hop. Uses an existing key or generates a dedicated one, and adds it to Arc's authorized_keys.\n[Set up key](command:arc.setup.key)",
            "media": {
              "markdown": "media/walkthrough/key.md"
            },
            "completionEvents": [
              "onContext:arc.setup.key"
            ]
          },
          {
            "id": "remote",
            "title": "Prepare Arc",
            "description": "Creates ~/projects, /work cache dirs and ~/.arc/arc.code-workspace (never overwrites an existing one).\n[Prepare Arc](command:arc.setup.remote)",
            "media": {
              "markdown": "media/walkthrough/remote.md"
            },
            "completionEvents": [
              "onContext:arc.setup.remote"
            ]
          },
          {
            "id": "verify",
            "title": "Verify",
            "description": "Runs a 5-minute test job and checks compute-node SSH, srun --overlap, lfs quota, vault and GPU GRES. Adapts the extension to the results.\n[Verify](command:arc.setup.verify)",
            "media": {
              "markdown": "media/walkthrough/verify.md"
            },
            "completionEvents": [
              "onContext:arc.setup.verified"
            ]
          },
          {
            "id": "open",
            "title": "Open the Arc workspace",
            "description": "Opens ~/.arc/arc.code-workspace on the login node. From there, allocate a node and click the status bar to move onto it.\n[Open workspace](command:arc.openWorkspace)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:arc.openWorkspace"
            ]
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "arc",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "partitions",
              "idle",
              "jobs",
              "watchJobs",
              "allocate",
              "release",
              "interactive",
              "submit",
              "submitAndFollow",
              "followLog",
              "efficiency",
              "storage",
              "purgeScan"
            ]
          },
          "partition": {
            "type": "string",
            "description": "Partition for allocate / interactive"
          },
          "walltime": {
            "type": "string",
            "description": "HH:MM:SS or D-HH:MM:SS"
          },
          "jobId": {
            "type": "string",
            "description": "Job for followLog / efficiency"
          },
          "file": {
            "type": "string",
            "description": "Batch script on Arc (default: current file)"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "arc-python",
        "owner": "arc",
        "source": "python",
        "fileLocation": [
          "absolute"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^\\s*File \"(\\/[^\"]+)\", line (\\d+)(?:, in (.*))?$",
          "file": 1,
          "line": 2,
          "message": 3
        }
      },
      {
        "name": "arc-python-watch",
        "base": "$arc-python",
        "background": {
          "activeBegins": true,
          "beginsPattern": "^==> arc: following",
          "endsPattern": "^==> arc: following"
        }
      }
    ],
    "commands": [
      {
        "command": "arc.monitor",
        "title": "Open Job Monitor",
        "category": "Arc",
        "icon": "$(pulse)"
      },
      {
        "command": "arc.setup.all",
        "title": "Run Setup",
        "category": "Arc",
        "icon": "$(gear)"
      },
      {
        "command": "arc.setup.ssh",
        "title": "Configure SSH",
        "category": "Arc"
      },
      {
        "command": "arc.setup.userSettings",
        "title": "Review User Settings",
        "category": "Arc"
      },
      {
        "command": "arc.setup.key",
        "title": "Set Up SSH Key",
        "category": "Arc"
      },
      {
        "command": "arc.setup.remote",
        "title": "Prepare Arc (dirs + workspace file)",
        "category": "Arc"
      },
      {
        "command": "arc.setup.verify",
        "title": "Verify Setup (test job)",
        "category": "Arc",
        "icon": "$(beaker)"
      },
      {
        "command": "arc.signIn",
        "title": "Sign In (DUO)",
        "category": "Arc",
        "icon": "$(key)"
      },
      {
        "command": "arc.signOut",
        "title": "Sign Out",
        "category": "Arc"
      },
      {
        "command": "arc.openWorkspace",
        "title": "Open Arc Workspace (login node)",
        "category": "Arc",
        "icon": "$(folder-opened)"
      },
      {
        "command": "arc.reviewWorkspaceSettings",
        "title": "Review Workspace Settings",
        "category": "Arc"
      },
      {
        "command": "arc.refresh",
        "title": "Refresh",
        "category": "Arc",
        "icon": "$(refresh)"
      },
      {
        "command": "arc.allocate",
        "title": "Allocate Compute Node for VS Code",
        "category": "Arc",
        "icon": "$(vm-connect)"
      },
      {
        "command": "arc.allocateOn",
        "title": "Allocate Node on This Partition",
        "category": "Arc",
        "icon": "$(vm-connect)"
      },
      {
        "command": "arc.connectNode",
        "title": "Open Workspace on Allocated Node",
        "category": "Arc",
        "icon": "$(remote)"
      },
      {
        "command": "arc.releaseNode",
        "title": "Release VS Code Node",
        "category": "Arc",
        "icon": "$(debug-stop)"
      },
      {
        "command": "arc.interactiveShell",
        "title": "Interactive Shell (srun --pty)",
        "category": "Arc",
        "icon": "$(terminal)"
      },
      {
        "command": "arc.submitBatch",
        "title": "Submit Batch Script (sbatch)",
        "category": "Arc",
        "icon": "$(rocket)"
      },
      {
        "command": "arc.jobDetails",
        "title": "Show Details (scontrol)",
        "category": "Arc",
        "icon": "$(info)"
      },
      {
        "command": "arc.jobLog",
        "title": "Open Output Log",
        "category": "Arc",
        "icon": "$(output)"
      },
      {
        "command": "arc.jobFollow",
        "title": "Follow Output Log",
        "category": "Arc",
        "icon": "$(eye)"
      },
      {
        "command": "arc.jobShell",
        "title": "Attach Shell to Job",
        "category": "Arc",
        "icon": "$(terminal)"
      },
      {
        "command": "arc.jobEfficiency",
        "title": "Efficiency (sacct)",
        "category": "Arc",
        "icon": "$(graph)"
      },
      {
        "command": "arc.jobCancel",
        "title": "Cancel Job",
        "category": "Arc",
        "icon": "$(close)"
      },
      {
        "command": "arc.jobHold",
        "title": "Hold Job",
        "category": "Arc",
        "icon": "$(debug-pause)"
      },
      {
        "command": "arc.jobRelease",
        "title": "Release Held Job",
        "category": "Arc",
        "icon": "$(debug-continue)"
      },
      {
        "command": "arc.jobRequeue",
        "title": "Requeue Job",
        "category": "Arc",
        "icon": "$(debug-restart)"
      },
      {
        "command": "arc.cancelAll",
        "title": "Cancel ALL My Jobs",
        "category": "Arc",
        "icon": "$(clear-all)"
      },
      {
        "command": "arc.storageTerminal",
        "title": "Open Terminal Here",
        "category": "Arc",
        "icon": "$(terminal)"
      },
      {
        "command": "arc.storageAdd",
        "title": "Add to Workspace",
        "category": "Arc",
        "icon": "$(add)"
      },
      {
        "command": "arc.purgeScan",
        "title": "Scan /work Purge Candidates",
        "category": "Arc",
        "icon": "$(warning)"
      },
      {
        "command": "arc.archiveToVault",
        "title": "Arc: Archive to Vault (rsync)",
        "category": "Arc"
      },
      {
        "command": "arc.stageToWork",
        "title": "Arc: Stage to /work (rsync)",
        "category": "Arc"
      },
      {
        "command": "arc.monitorJob",
        "title": "Monitor Job",
        "category": "Arc",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "arc.allocateOn",
          "when": "false"
        },
        {
          "command": "arc.storageTerminal",
          "when": "false"
        },
        {
          "command": "arc.storageAdd",
          "when": "false"
        },
        {
          "command": "arc.archiveToVault",
          "when": "false"
        },
        {
          "command": "arc.stageToWork",
          "when": "false"
        },
        {
          "command": "arc.monitorJob",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "arc.allocate",
          "when": "view == arc.jobs",
          "group": "navigation@1"
        },
        {
          "command": "arc.monitor",
          "when": "view == arc.jobs",
          "group": "navigation@2"
        },
        {
          "command": "arc.refresh",
          "when": "view =~ /^arc\\./",
          "group": "navigation@9"
        },
        {
          "command": "arc.interactiveShell",
          "when": "view == arc.jobs"
        },
        {
          "command": "arc.releaseNode",
          "when": "view == arc.jobs"
        },
        {
          "command": "arc.cancelAll",
          "when": "view == arc.jobs"
        },
        {
          "command": "arc.setup.verify",
          "when": "view =~ /^arc\\./"
        },
        {
          "command": "arc.setup.all",
          "when": "view =~ /^arc\\./"
        },
        {
          "command": "arc.signOut",
          "when": "view =~ /^arc\\./ && arc.setup.signedIn"
        }
      ],
      "view/item/context": [
        {
          "command": "arc.monitorJob",
          "when": "viewItem =~ /^job:/",
          "group": "inline@0"
        },
        {
          "command": "arc.connectNode",
          "when": "viewItem =~ /^job:running:holder/",
          "group": "inline@1"
        },
        {
          "command": "arc.jobShell",
          "when": "viewItem =~ /^job:running/",
          "group": "inline@2"
        },
        {
          "command": "arc.jobFollow",
          "when": "viewItem =~ /^job:/",
          "group": "inline@3"
        },
        {
          "command": "arc.jobCancel",
          "when": "viewItem =~ /^job:/",
          "group": "inline@9"
        },
        {
          "command": "arc.jobDetails",
          "when": "viewItem =~ /^job:/",
          "group": "1_inspect@1"
        },
        {
          "command": "arc.jobLog",
          "when": "viewItem =~ /^job:/",
          "group": "1_inspect@2"
        },
        {
          "command": "arc.jobEfficiency",
          "when": "viewItem =~ /^job:/",
          "group": "1_inspect@3"
        },
        {
          "command": "arc.jobHold",
          "when": "viewItem =~ /^job:pending/",
          "group": "2_control@1"
        },
        {
          "command": "arc.jobRelease",
          "when": "viewItem =~ /^job:pending/",
          "group": "2_control@2"
        },
        {
          "command": "arc.jobRequeue",
          "when": "viewItem =~ /^job:running/",
          "group": "2_control@3"
        },
        {
          "command": "arc.allocateOn",
          "when": "viewItem == partition",
          "group": "inline"
        },
        {
          "command": "arc.storageTerminal",
          "when": "viewItem =~ /^storage/",
          "group": "inline@1"
        },
        {
          "command": "arc.storageAdd",
          "when": "viewItem =~ /^storage/",
          "group": "inline@2"
        },
        {
          "command": "arc.purgeScan",
          "when": "viewItem == storage:purge",
          "group": "inline@3"
        }
      ],
      "explorer/context": [
        {
          "command": "arc.archiveToVault",
          "when": "resourceScheme == vscode-remote && resourcePath =~ /^\\/work\\//",
          "group": "7_arc@1"
        },
        {
          "command": "arc.stageToWork",
          "when": "resourceScheme == vscode-remote && resourcePath =~ /^\\/(home|vault)\\//",
          "group": "7_arc@2"
        },
        {
          "command": "arc.submitBatch",
          "when": "resourceScheme == vscode-remote && resourceExtname =~ /^\\.(sbatch|slurm|sh)$/",
          "group": "7_arc@3"
        }
      ],
      "editor/title": [
        {
          "command": "arc.submitBatch",
          "when": "resourceScheme == vscode-remote && resourceExtname =~ /^\\.(sbatch|slurm)$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Arc HPC",
      "properties": {
        "arc.utsaId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Your myUTSA ID (SSH user on Arc). Set by setup."
        },
        "arc.sshLoginHost": {
          "type": "string",
          "default": "arc",
          "scope": "application",
          "description": "SSH alias for the login node."
        },
        "arc.sshNodeHost": {
          "type": "string",
          "default": "arc-node",
          "scope": "application",
          "description": "SSH alias that proxies to your allocated compute node."
        },
        "arc.holdJobName": {
          "type": "string",
          "default": "vscode",
          "description": "Job name of the placeholder job that holds your VS Code node. Must match ARC_HOLD_JOB in the proxy (default vscode)."
        },
        "arc.defaultPartition": {
          "type": "string",
          "default": "compute1"
        },
        "arc.defaultWalltime": {
          "type": "string",
          "default": "04:00:00"
        },
        "arc.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10
        },
        "arc.hiddenPartitions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "softmatter",
            "dgxa100",
            "uavlab",
            "uavlab2",
            "trustlab"
          ],
          "description": "Private partitions you are not authorized for."
        },
        "arc.requestGpuGres": {
          "type": "boolean",
          "default": true,
          "description": "Add --gres=<GPU GRES reported by sinfo> on GPU partitions."
        },
        "arc.purgeWarnDays": {
          "type": "number",
          "default": 25,
          "description": "Flag /work files not accessed for this many days (Arc purges at 30)."
        },
        "arc.notifyOnJobEnd": {
          "type": "boolean",
          "default": true
        },
        "arc.nodeSshAvailable": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "application",
          "description": "Set by verification. false disables opening VS Code on compute nodes."
        },
        "arc.srunOverlap": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use srun --overlap when attaching shells (set by verification)."
        },
        "arc.limits": {
          "type": "object",
          "default": {
            "maxJobs": 10,
            "maxNodes": 20
          },
          "properties": {
            "maxJobs": {
              "type": "number"
            },
            "maxNodes": {
              "type": "number"
            }
          }
        },
        "arc.appliedTemplate": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "scope": "window",
          "description": "Internal: the Arc workspace template last applied here (used to respect your edits). Don't edit."
        },
        "arc.storage": {
          "type": "array",
          "default": [
            {
              "label": "home",
              "path": "${home}",
              "quotaMount": "/home",
              "purpose": "Backed up · 100 GB hard quota · code, envs, builds"
            },
            {
              "label": "work",
              "path": "/work/${user}",
              "quotaMount": "/work",
              "purpose": "NOT backed up · files unaccessed 30 days may be purged · job I/O, datasets, logs",
              "purge": true
            },
            {
              "label": "vault",
              "path": "/vault/research/${user}",
              "quotaMount": "",
              "purpose": "Backed up + replicated to UT Arlington · 1 TB · archive"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "quotaMount": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "purge": {
                "type": "boolean"
              }
            }
          }
        },
        "arc.monitorInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "description": "Seconds between live samples in the job monitor."
        },
        "arc.monitorMaxMinutes": {
          "type": "number",
          "default": 240,
          "minimum": 5,
          "description": "The node-side sampler stops on its own after this long, even if the panel stays open."
        }
      }
    }
  }
}
